# wgvim: compile the SHA256 of every bundled tree-sitter parser into the binary.
#
# The editor refuses to dlopen() a parser whose contents do not match the hash recorded here
# (see load_language_from_object() in src/nvim/lua/treesitter.c and SECURITY-AUDIT.md).
#
# Usage: cmake -D PARSER_DIR=<dir with *.so> -D OUTPUT=<header> -P GenerateParserHashes.cmake

if(NOT PARSER_DIR OR NOT OUTPUT)
  message(FATAL_ERROR "GenerateParserHashes.cmake: PARSER_DIR and OUTPUT are required")
endif()

file(GLOB parsers "${PARSER_DIR}/*.so")
list(SORT parsers)

set(body "")
foreach(parser ${parsers})
  get_filename_component(name "${parser}" NAME_WE)
  if(NOT name MATCHES "^[A-Za-z0-9_]+$")
    message(FATAL_ERROR "GenerateParserHashes.cmake: unexpected parser file name: ${parser}")
  endif()
  file(SHA256 "${parser}" hash)
  string(APPEND body "  { \"${name}\", \"${hash}\" },\n")
endforeach()

set(content "// Generated by cmake/GenerateParserHashes.cmake. Do not edit.
// Bundled tree-sitter parsers and the SHA256 of each .so file.
static const struct {
  const char *name;
  const char *sha256;
} ts_parser_hashes[] = {
${body}  { NULL, NULL },
};
")

# Only rewrite when the content changes, to avoid needless rebuilds.
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" old)
endif()
if(NOT old STREQUAL content)
  file(WRITE "${OUTPUT}" "${content}")
endif()
list(LENGTH parsers n)
message(STATUS "GenerateParserHashes: ${n} parser hashes written to ${OUTPUT}")
